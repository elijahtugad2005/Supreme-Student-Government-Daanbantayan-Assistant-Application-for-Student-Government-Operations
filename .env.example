# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# Messenger API (Optional)
VITE_META_REACT_TO_MESSENGER_TOKEN_ID=your_messenger_token_here

# Google OAuth Configuration (Required for Google Sign-In)
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id_here
VITE_GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret_here

# Telegram Publishing (announcements)
# NOTE: the bot token is exposed to the browser at runtime. Use a token that
# only has access to the channels below, and rotate it if it leaks.
TELEGRAM_BOT_API=your_telegram_bot_token_here
TELEGRAM_CTUDBFACULTIES_CHANNELID=your_faculty_channel_id_here
TELEGRAM_CTUDBALLMAYORS_CHANNELID=your_all_mayors_channel_id_here

# AI — Gemini (document intelligence)
# IMPORTANT: do NOT prefix this with VITE_.
#   Vite inlines only VITE_* variables into the browser bundle, so an unprefixed
#   name stays server-side. A VITE_GEMINI_API_KEY would ship your key to every
#   visitor. The Gemini call belongs in a Cloud Function, never in React.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# File storage backend for documents
#   local     IndexedDB on this device (default). No bucket needed.
#   firebase  Cloud Storage. Set after creating the bucket.
VITE_FILE_STORE=local

# Point the app at the local Firebase emulators.
# Leave this UNSET for production. When true, start them first:  npm run emulators
#
# By DEFAULT only the unctions emulator is redirected. Auth deliberately stays
# on the real project, because the Auth emulator knows nothing about your real
# accounts and Google sign-in would break. Firestore and Storage also stay live so
# the app keeps reading your real data.
#
# Opt in to more only when testing those in isolation:
# VITE_USE_EMULATORS=true
# VITE_EMULATOR_SERVICES=firestore,storage

# Backend Configuration
VITE_BACKEND_API_URL=http://localhost:5000

# Security Configuration
VITE_SESSION_SECRET=your_session_secret_here