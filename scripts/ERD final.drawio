        <mxCell id="p1-lg-n0" value="PK = primary key (bold underline) · FK = foreign key (italic) · UQ = unique · * = required" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="927" y="252" width="320" height="34" as="geometry"/></mxCell>
        <mxCell id="p1-lg-n1" value="Solid line = enforced FK (firestore.rules or service layer)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="927" y="290" width="320" height="34" as="geometry"/></mxCell>
        <mxCell id="p1-lg-n2" value="Dashed line = logical reference (nested path, array, polymorphic, business key, or cross-datastore)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="927" y="328" width="320" height="34" as="geometry"/></mxCell>
        <mxCell id="p1-lg-n3" value="Crow's foot = many · single bar = exactly one · circle = optional (zero)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="927" y="366" width="320" height="34" as="geometry"/></mxCell>
        <mxCell id="p1-lg-n4" value="Line color = color of the table that holds the foreign key" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="927" y="404" width="320" height="34" as="geometry"/></mxCell>
