        <mxCell id="p4-lg-n2" value="Dashed line = logical reference (nested path, array, polymorphic, business key, or cross-datastore)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="1500" y="328" width="320" height="34" as="geometry"/></mxCell>
        <mxCell id="p4-lg-n3" value="Crow's foot = many · single bar = exactly one · circle = optional (zero)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="1500" y="366" width="320" height="34" as="geometry"/></mxCell>
