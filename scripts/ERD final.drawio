        <mxCell id="p4-lg-n0" value="PK = primary key (bold underline) · FK = foreign key (italic) · UQ = unique · * = required" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="1500" y="252" width="320" height="34" as="geometry"/></mxCell>
