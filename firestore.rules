rules_version = '2';

// =============================================================================
// firestore.rules
//
// READ THIS BEFORE DEPLOYING
// -----------------------
// This repository previously had NO rules file. Whatever rules are live in the
// Firebase console for project `ssg-prototype` were set up outside the repo and
// are therefore NOT reflected here.
//
// The roster rules (classRosters / classSections) are strict and are the point
// of this file. The rules for every other collection are deliberately written to
// match how the app already behaves — review them against the console before
// deploying, or you may lock out a feature that currently works.
//
// Deploy with:  firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userPath());
    }

    // Single-lookup check on a user doc map: legacy docs omitting `isActive`
    // remain active; only explicit `isActive == false` is deactivated.
    function isActiveData(d) {
      return d.get('isActive', true) != false;
    }

    // True when the user has a profile document and has NOT been deactivated.
    function isActiveUser() {
      return hasUserDoc() && isActiveData(get(userPath()).data);
    }

    // True when signed in and NOT explicitly deactivated in users/{uid}.
    function isNotDeactivated() {
      return isSignedIn() && (!hasUserDoc() || isActiveUser());
    }

    // The role stored on an active user document. Anonymous and deactivated callers get null.
    function myRole() {
      return hasUserDoc() ? activeRoleOf(get(userPath()).data) : null;
    }

    function activeRoleOf(d) {
      return isActiveData(d) ? d.get('role', null) : null;
    }

    // True when the caller's Firebase Auth token carries an official @ctu.edu.ph email.
    function isInstitutionalCtuEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('^[^@\\s]+@ctu\\.edu\\.ph$');
    }

    // True when a self-registered student member has BOTH a @ctu.edu.ph email AND
    // a verified email address in their Firebase Auth token.
    function isVerifiedInstitutionalMember() {
      return myRole() == 'member'
        && isInstitutionalCtuEmail()
        && request.auth.token.email_verified == true;
    }

    // Authenticated account with a verified non-guest institutional/student role.
    // Officers/admins pass via their assigned role; student members MUST have a
    // verified @ctu.edu.ph institutional email so random internet signups cannot
    // interact with Class Rosters, Death Aid drives, or audit trails.
    function isAuthenticatedNonGuest() {
      let r = myRole();
      return r != null && r != 'guest' && (r != 'member' || isVerifiedInstitutionalMember());
    }

    function isAdmin() {
      return myRole() in ['admin', 'president'];
    }

    // SSG Officers: roles allowed to verify rosters and manage institutional records.
    function isOfficer() {
      return myRole() in [
        'admin',
        'president',
        'vice_president',
        'secretary',
        'executive_secretary',
        'press_secretary',
        'linkages_secretary',
        'deputy_secretary'
      ];
    }

    // True when an Admin has individually granted this account a permission.
    // Mirrors the `permissionOverrides` map written by User Management, so the
    // database agrees with what the UI offers. Without this the roster browser
    // would appear for a granted user and then fail on every query.
    function dataHasOverride(d, permission) {
      let ov = d.get('permissionOverrides', {});
      return isActiveData(d) && ov is map && ov.get(permission, false) == true;
    }

    function hasOverride(permission) {
      return hasUserDoc() && dataHasOverride(get(userPath()).data, permission);
    }

    // Roles allowed to read student lists. Mayors (who are Guests) and Members
    // may submit a roster but must never read one back — this mirrors
    // `canViewRosters` in src/utils/permissions.js. The Secretary is included
    // because verifying a submission requires reading it.
    function canReadRosters() {
      return hasUserDoc() && canReadRostersData(get(userPath()).data);
    }

    function canReadRostersData(d) {
      return isActiveData(d) && (
        d.get('role', null) in ['admin', 'secretary', 'governor']
        || dataHasOverride(d, 'canViewRosters')
      );
    }

    // Roles allowed to accept a remittance and confirm it. Must stay in step with
    // DEATH_AID_MANAGER_ROLES in src/utils/permissions.js. An allowlist, so any
    // role not named here — Members, Guests, Creatives — is excluded.
    // Note this is wider than isOfficer(), which still governs roster
    // verification and the section registry.
    function canManageDeathAid() {
      return myRole() in [
        'admin',
        'president',
        'vice_president',
        'secretary',
        'executive_secretary',
        'press_secretary',
        'linkages_secretary',
        'deputy_secretary',
        'finance_secretary',
        'auditor',
        'budget_officer',
        'governor',
        'representative',
        'senator'
      ];
    }

    // A Mayor may read exactly one roster: the one they submitted. They cannot
    // browse the roster registry, but Death Aid payment marks have to be made
    // against their own students.
    function isOwnRoster() {
      return isActiveUser() && resource.data.mayorUid == request.auth.uid;
    }

    // A submission is only ever a proposal. `status`, `isCurrent` and `version`
    // are the fields that make a roster official, so nobody outside an officer
    // may set them.
    function isUnverifiedProposal() {
      return request.resource.data.status == 'pending'
        && request.resource.data.isCurrent == false
        && request.resource.data.version == null;
    }

    function hasRosterShape() {
      return request.resource.data.keys().hasAll([
          'college', 'program', 'section', 'sectionKey',
          'students', 'studentCount', 'status', 'submittedAt'
        ])
        && request.resource.data.students is list
        && request.resource.data.studentCount == request.resource.data.students.size();
    }

    // =========================================================================
    // CLASS ROSTERS
    //
    // The financial guarantee: a Mayor may submit a list, but only an officer
    // can turn one into the verified roster that Death Aid reporting bills
    // against. Anonymous visitors can submit too — Mayors have no login.
    // =========================================================================
    match /classRosters/{rosterId} {

      // Student lists are readable by Governors, the Secretary and Admin only,
      // plus the Mayor who submitted the roster (needed to mark payments).
      // Everyone else may still create a roster (see `allow create` below).
      allow read: if canReadRosters() || isOwnRoster();

      // Only authenticated non-guest accounts (e.g. signed-in students/mayors or officers)
      // may submit a roster proposal, preventing anonymous/guest spam attacks.
      allow create: if isAuthenticatedNonGuest()
        && isUnverifiedProposal()
        && hasRosterShape()
        && request.resource.data.mayorUid == request.auth.uid;

      // Only officers may act on a roster arbitrarily.
      // A roster that is already verified has its student list frozen, so an
      // officer cannot silently rewrite an official historical record; the only
      // way to change a verified list is to verify a NEW submission, which
      // supersedes this one and preserves it as an earlier version.
      //
      // The submitter also has limited rights, because a Mayor who uploaded the
      // wrong file must be able to fix it:
      //   - while it is still pending they may edit or delete it freely;
      //   - a VERIFIED roster may only be amended for student transfers, and
      //     such an amendment is forced back to pending so an officer verifies
      //     it. It is never applied silently to an official record.
      allow update: if (
        isOfficer() && (
          resource.data.status != 'verified'
          || request.resource.data.students == resource.data.students
        )
      ) || (
        isAuthenticatedNonGuest()
        && resource.data.mayorUid == request.auth.uid
        && request.resource.data.mayorUid == resource.data.mayorUid
        && isUnverifiedProposal()
        && hasRosterShape()
        && (
          resource.data.status != 'verified'
          || (
            // Transfers must be declared, and re-verified before they count.
            request.resource.data.hasTransfers == true
            && request.resource.data.transferCount is int
            && request.resource.data.transferCount > 0
            && request.resource.data.transferReason is string
            && request.resource.data.transferReason.size() > 0
          )
        )
      );

      // Deleting a VERIFIED roster stays admin-only: it is the source of the
      // enrolled count behind historical Death Aid collections (officers revoke
      // verification via update instead). Officers may remove unverified
      // submissions, and submitters may withdraw their own unverified submission.
      allow delete: if isAdmin()
        || (isOfficer() && resource.data.status != 'verified')
        || (
          isActiveUser()
          && resource.data.mayorUid == request.auth.uid
          && resource.data.status != 'verified'
        );
    }

    // =========================================================================
    // CLASS SECTIONS (the registry)
    //
    // Maintained by officers on verification. Authorized Death Aid officers may
    // also seed a `placeholder` section when recording an unlisted section so
    // Class Mayors can see and claim it by uploading the official class roster.
    // =========================================================================
    match /classSections/{sectionId} {
      allow read: if canReadRosters()
        || (isAuthenticatedNonGuest() && resource.data.status == 'placeholder');
      allow create: if isOfficer()
        || (
          canManageDeathAid()
          && request.resource.data.status == 'placeholder'
          && request.resource.data.isPlaceholder == true
          && request.resource.data.currentRosterId == null
        );
      allow update, delete: if isOfficer();
    }

    // =========================================================================
    // USERS
    // =========================================================================
    match /users/{userId} {
      allow read: if isAdmin() || isOfficer() || (isSignedIn() && request.auth.uid == userId);

      // Self-registration may only ever assign 'member' or 'guest' with no
      // permissionOverrides — otherwise a new user could create their profile
      // with role: 'admin'. Only Admins (admin/president, matching
      // canManageUsers: true in permissions.js) may provision arbitrary user
      // accounts; non-admin isOfficer() roles must never create user docs.
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role in ['member', 'guest']
          && (
            request.resource.data.role == 'guest'
            || isInstitutionalCtuEmail()
          )
          && !('permissions' in request.resource.data)
          && (
            !('permissionOverrides' in request.resource.data)
            || (
              request.resource.data.permissionOverrides is map
              && request.resource.data.permissionOverrides.size() == 0
            )
          )
        );

      // Changing role, permissions, permissionOverrides, or active/deletion
      // status is strictly an administrative act (isAdmin() only — never
      // isOfficer(), whose vice_president and Secretariat roles have
      // canManageUsers: false and could otherwise self-promote to admin and
      // trigger onUserRoleUpdated). Any signed-in user may still edit benign
      // fields on their own profile.
      allow update: if isAdmin()
        || (
          isActiveUser()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'permissionOverrides', 'permissions', 'isActive', 'deletedAt', 'deletedBy'])
        );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // AUDIT LOGS — append only, never editable or removable
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isOfficer();
      allow create: if isNotDeactivated();
      allow update, delete: if false;
    }

    // =========================================================================
    // PUBLIC-FACING CONTENT — readable without signing in, writable by officers
    // =========================================================================
    function canManageAnnouncements() {
      return hasUserDoc() && canManageAnnouncementsData(get(userPath()).data);
    }

    function canManageAnnouncementsData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'superadmin',
          'president',
          'vice_president',
          'secretary',
          'general_secretary',
          'executive_secretary',
          'press_secretary',
          'linkages_secretary',
          'deputy_secretary',
          'creatives',
          'governor',
          'adviser',
          'senator',
          'representative'
        ]
        || dataHasOverride(d, 'canSendNotifications')
        || dataHasOverride(d, 'canManageAnnouncements')
        || dataHasOverride(d, 'canCreateAnnouncements')
      );
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if canManageAnnouncements();
    }

    match /newsArticles/{docId} {
      allow read: if true;
      allow write: if canManageAnnouncements();
    }

    match /calendarEvents/{docId} {
      allow read: if true;
      allow write: if canManageAnnouncements();
    }

    match /terms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // INVENTORY & BORROWING LOGS — public/signed-in readable, officer-managed writes
    // =========================================================================
    match /inventory/{docId} {
      allow read: if true;
      allow write: if canManageOrders() || isAdmin() || hasOverride('canManageInventory');
    }

    // =========================================================================
    // MEMBERS / ORGANIZATIONS
    // =========================================================================
    match /members/{memberId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin() || canManageOrders() || hasOverride('canManageMembers');
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }

    match /borrowingLogs/{logId} {
      allow read: if canManageOrders() || isOfficer() || isAdmin() || hasOverride('canManageInventory');
      allow write: if canManageOrders() || isAdmin() || hasOverride('canManageInventory');
    }

    // =========================================================================
    // FINANCE — officers & authorized finance viewers only.
    // Self-registered members/guests must NOT read internal treasury budgets/funds.
    // =========================================================================
    match /budgets/{budgetId} {
      allow read: if canViewFinance() || isOfficer() || isAdmin();
      allow write: if isOfficer() || isAdmin();
    }

    match /funds/{fundId} {
      allow read: if canViewFinance() || isOfficer() || isAdmin();
      allow write: if myRole() == 'finance_secretary' 
        || myRole() == 'auditor' 
        || myRole() == 'budget_officer' 
        || isOfficer() 
        || isAdmin();
    }

    // =========================================================================
    // DEATH AID
    //
    // Integrity rules that the client cannot be trusted to enforce:
    //   - a collection must belong to a roster this Mayor actually submitted
    //   - expectedCollection must equal paidCount x contributionPerStudent
    //   - the counts must agree with the payment marks
    //   - a Mayor may never confirm their own remittance
    //   - remittance amounts are written once and never overwritten
    // =========================================================================

    // The roster a collection was built from, used to prove ownership.
    function rosterFor(id) {
      return get(/databases/$(database)/documents/classRosters/$(id)).data;
    }

    // A collection whose arithmetic is self-consistent and whose enrolled count
    // either matches the verified roster it was recorded against, OR (strictly
    // for authorized Death Aid officers) records an unlisted placeholder section
    // awaiting a Class Mayor's official roster upload.
    function hasValidCollectionTotals() {
      let r = request.resource.data;
      return isAuthenticatedNonGuest()
        && r.recordedByUid == request.auth.uid
        && r.enrolledCount is int
        && r.enrolledCount > 0
        && r.beneficiaryCount >= 0
        && r.beneficiaryCount <= r.enrolledCount
        && r.contributionPerStudent >= 0
        && r.expectedCollection == r.enrolledCount * r.contributionPerStudent
        && r.debtCount == r.enrolledCount - r.beneficiaryCount
        && (
          (
            r.collectedAmount == r.beneficiaryCount * r.contributionPerStudent
            && r.debtAmount == r.debtCount * r.contributionPerStudent
          )
          || (
            canManageDeathAid()
            && r.entryMode == 'amount'
            && r.collectedAmount is number
            && r.collectedAmount >= 0
            && r.debtAmount is number
            && r.debtAmount >= 0
          )
        )
        && r.status == 'for_verification'
        && (
          !('beneficiaryCaseId' in r)
          || (
            r.beneficiaryCaseId is string
            && get(/databases/$(database)/documents/deathAidBeneficiaries/$(r.beneficiaryCaseId)).data.status == 'open'
          )
        )
        && (
          (
            r.rosterId is string
            && r.rosterId.size() > 0
            && rosterFor(r.rosterId).status == 'verified'
            && r.enrolledCount == rosterFor(r.rosterId).studentCount
          )
          || (
            canManageDeathAid()
            && r.isPlaceholderSection == true
            && r.rosterId == null
            && r.section is string
            && r.section.size() > 0
            && r.sectionKey is string
            && r.sectionKey.size() > 0
          )
        );
    }

    // Official Death Aid / TechnoCare beneficiary cases (memo + affected person + release photo evidence).
    // Officers may read all cases (open, closed, released). Verified @ctu.edu.ph student members may
    // ONLY read currently `open` drives — blocking unverified/outsider signups and hiding closed/released
    // beneficiary handover records from non-officers.
    match /deathAidBeneficiaries/{beneficiaryId} {
      allow read: if canManageDeathAid()
        || (isVerifiedInstitutionalMember() && resource.data.status == 'open');
      allow create, update: if canManageDeathAid()
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.affectedPersonName is string
        && request.resource.data.affectedPersonName.size() > 0
        && request.resource.data.memoPhotoDataUrl is string
        && request.resource.data.memoPhotoDataUrl.size() > 0
        && request.resource.data.aidType in ['death_aid', 'technocare']
        && request.resource.data.status in ['open', 'closed', 'released']
        && (
          request.resource.data.status != 'released'
          || (
            request.resource.data.releasePhotoDataUrl is string
            && request.resource.data.releasePhotoDataUrl.size() > 0
            && request.resource.data.recipientName is string
            && request.resource.data.recipientName.size() > 0
            && request.resource.data.releasedAmount is number
            && request.resource.data.releasedAmount >= 0
            && request.resource.data.releasedByUid == request.auth.uid
          )
        );
      allow delete: if isAdmin();
    }

    match /deathAidCollections/{collectionId} {
      // Officers read all campus collections; verified @ctu.edu.ph student members (Class Mayors)
      // may ONLY read their own submitted collections — never other sections' payment/debt lists.
      allow read: if canManageDeathAid()
        || (isVerifiedInstitutionalMember() && resource.data.recordedByUid == request.auth.uid);

      // Recorded by an authenticated non-guest account (student/mayor or officer).
      // Arithmetic totals MUST strictly balance against beneficiaryCount * contributionPerStudent.
      allow create: if hasValidCollectionTotals();

      // Only officers can verify or update death aid collections
      allow update: if canManageDeathAid()
        && request.resource.data.enrolledCount == resource.data.enrolledCount
        && request.resource.data.beneficiaryCount == resource.data.beneficiaryCount
        && request.resource.data.contributionPerStudent == resource.data.contributionPerStudent
        && request.resource.data.collectedAmount == resource.data.collectedAmount
        && request.resource.data.expectedCollection == resource.data.expectedCollection
        && request.resource.data.debtCount == resource.data.debtCount
        && request.resource.data.debtAmount == resource.data.debtAmount
        && request.resource.data.recordedByUid == resource.data.recordedByUid
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.debtRecords.size() <= resource.data.debtCount;

      allow delete: if isAdmin();
    }

    match /deathAidRemittances/{remittanceId} {
      allow read: if canManageDeathAid();

      // Written once, by an officer, for a collection still awaiting
      // verification. An officer who RECORDED the collection holds the same
      // cash, so they may not also certify it. (Guest submissions have null recordedByUid).
      allow create: if canManageDeathAid()
        && (
          request.auth.uid != get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.recordedByUid
          || get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.recordedByUid == null
        )
        && get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.status
             == 'for_verification'
        && request.resource.data.collectionId == remittanceId
        && request.resource.data.reportedAmount
             == get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.collectedAmount
        && request.resource.data.difference
             == request.resource.data.amountReceived - request.resource.data.reportedAmount
        && request.resource.data.status == (
               request.resource.data.difference == 0 ? 'confirmed' : 'discrepancy'
             )
        && request.resource.data.receivedByUid == request.auth.uid;

      // Amounts are immutable on resolution/revocation. An officer may mark a
      // discrepancy resolved, revoke verification (returning the collection to
      // pending), or re-verify a previously revoked remittance when the parent
      // collection is back in `for_verification`.
      allow update: if canManageDeathAid() && (
        (
          request.resource.data.reportedAmount == resource.data.reportedAmount
          && request.resource.data.amountReceived == resource.data.amountReceived
          && request.resource.data.difference == resource.data.difference
          && request.resource.data.receivedByUid == resource.data.receivedByUid
          && request.resource.data.status in ['resolved', 'revoked']
        )
        || (
          resource.data.status == 'revoked'
          && get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.status
               == 'for_verification'
          && (
            request.auth.uid != get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.recordedByUid
            || get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.recordedByUid == null
          )
          && request.resource.data.collectionId == remittanceId
          && request.resource.data.reportedAmount
               == get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.collectedAmount
          && request.resource.data.difference
               == request.resource.data.amountReceived - request.resource.data.reportedAmount
          && request.resource.data.status == (
                 request.resource.data.difference == 0 ? 'confirmed' : 'discrepancy'
               )
          && request.resource.data.receivedByUid == request.auth.uid
        )
      );

      allow delete: if isAdmin();
    }

    // Append-only audit trail. Authenticated non-guest users may append their own submission actions,
    // blocking anonymous/guest spam and UID spoofing.
    match /deathAidAuditLog/{entryId} {
      allow read: if canManageDeathAid();
      allow create: if isAuthenticatedNonGuest()
        && request.resource.data.collectionId is string
        && request.resource.data.action is string
        && (
          canManageDeathAid()
          || request.resource.data.actorUid == request.auth.uid
        );
      allow update, delete: if false;
    }

    // Collection id allocation counter — strictly monotonic (+1 per transaction),
    // restricted to authenticated non-guest accounts to prevent counter exhaustion attacks.
    match /deathAidCounters/{year} {
      allow read: if isAuthenticatedNonGuest();
      allow create: if isAuthenticatedNonGuest()
        && request.resource.data.keys().hasOnly(['count', 'year', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.year is int;
      allow update: if isAuthenticatedNonGuest()
        && request.resource.data.keys().hasOnly(['count', 'year', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.year == resource.data.year;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // DOCUMENT REPOSITORY (Phase 1)
    //
    // Firestore holds the searchable record; the binary lives in Storage.
    // Roles are checked against the office that manages documents, which is
    // kept deliberately narrow — a member should not be able to read every
    // signed administrative record in the institution.
    // =========================================================================

    // Roles permitted to work with the document archive.
    function canManageDocuments() {
      return hasUserDoc() && canManageDocumentsData(get(userPath()).data);
    }

    function canManageDocumentsData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'president',
          'vice_president',
          'secretary',
          'executive_secretary',
          'press_secretary',
          'linkages_secretary',
          'deputy_secretary',
          'finance_secretary',
          'auditor',
          'budget_officer',
          'representative',
          'senator'
        ]
        || dataHasOverride(d, 'canExportData')
      );
    }

    function canDeleteDocuments() {
      return hasUserDoc() && canDeleteDocumentsData(get(userPath()).data);
    }

    function canDeleteDocumentsData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'president',
          'vice_president',
          'secretary',
          'executive_secretary',
          'press_secretary',
          'linkages_secretary',
          'deputy_secretary',
          'finance_secretary',
          'auditor',
          'budget_officer'
        ]
        || dataHasOverride(d, 'canDeleteData')
      );
    }

    match /documents/{documentId} {
      allow read: if canManageDocuments();
      allow create: if canManageDocuments() && isSignedIn();
      allow update: if canManageDocuments() && isSignedIn();
      allow delete: if canDeleteDocuments();

      // Reserved for Phase 4: per-document signature checklists.
      match /signatures/{signatureId} {
        allow read: if canManageDocuments();
        allow write: if isAdmin() || myRole() == 'secretary';
      }

      // Reserved for Phase 1/3: append-only activity history.
      match /auditLogs/{logId} {
        allow read: if canManageDocuments();
        allow create: if canManageDocuments() && isSignedIn();
        allow update, delete: if false;
      }
    }

    // The label taxonomy. Anyone managing documents may define labels, since
    // labels are vocabulary rather than records.
    match /documentLabels/{labelId} {
      allow read: if canManageDocuments();
      allow write: if canManageDocuments() && isSignedIn();
    }

    // Reserved for Phase 6/7: report templates and approval workflows.
    match /documentTemplates/{templateId} {
      allow read: if canManageDocuments();
      allow write: if isAdmin() || myRole() == 'secretary';
    }

    match /officials/{officialId} {
      allow read: if canManageDocuments();
      allow write: if isAdmin() || myRole() == 'secretary';
    }

    match /approvalWorkflows/{workflowId} {
      allow read: if canManageDocuments();
      allow write: if isAdmin() || myRole() == 'secretary';
    }

    // Campus Map Trees & Annotations: public can read, strictly admins can write.
    match /campusMetadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // FINANCE & TREASURY GOVERNANCE
    // =========================================================================
    function canViewFinance() {
      return hasUserDoc() && canViewFinanceData(get(userPath()).data);
    }

    function canViewFinanceData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'president',
          'vice_president',
          'secretary',
          'executive_secretary',
          'finance_secretary',
          'auditor',
          'budget_officer'
        ]
        || dataHasOverride(d, 'canViewFinance')
      );
    }

    function canEditFinance() {
      return hasUserDoc() && canEditFinanceData(get(userPath()).data);
    }

    function canEditFinanceData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'president',
          'vice_president',
          'finance_secretary',
          'auditor',
          'budget_officer'
        ]
        || dataHasOverride(d, 'canEditFinance')
      );
    }

    function canApproveFinance() {
      return hasUserDoc() && canApproveFinanceData(get(userPath()).data);
    }

    function canApproveFinanceData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'president',
          'vice_president',
          'finance_secretary',
          'auditor',
          'budget_officer'
        ]
        || dataHasOverride(d, 'canApproveFinance')
      );
    }

    function canAuditClear() {
      return hasUserDoc() && canAuditClearData(get(userPath()).data);
    }

    function canAuditClearData(d) {
      return isActiveData(d) && (
        d.get('role', null) in ['admin', 'president', 'auditor']
        || dataHasOverride(d, 'canAuditFinance')
      );
    }

    function canManageCentralizedOrderSheet() {
      return hasUserDoc() && canManageCentralizedOrderSheetData(get(userPath()).data);
    }

    function canManageCentralizedOrderSheetData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'secretary',
          'executive_secretary',
          'deputy_secretary',
          'press_secretary',
          'linkages_secretary',
          'finance_secretary'
        ]
        || dataHasOverride(d, 'canManageCentralizedOrderSheet')
      );
    }

    function canManageOrders() {
      return hasUserDoc() && canManageOrdersData(get(userPath()).data);
    }

    function canManageOrdersData(d) {
      return isActiveData(d) && (
        d.get('role', null) in [
          'admin',
          'president',
          'vice_president',
          'secretary',
          'executive_secretary',
          'deputy_secretary',
          'press_secretary',
          'linkages_secretary',
          'finance_secretary',
          'auditor',
          'budget_officer',
          'governor',
          'representative',
          'senator'
        ]
        || dataHasOverride(d, 'canManageOrders')
      );
    }

    // System & Centralized Sheet Settings
    match /settings/{settingId} {
      allow read: if settingId == 'app'
        || isAdmin()
        || isOfficer()
        || canManageCentralizedOrderSheet();
      allow write: if settingId == 'commerceOrderSheet'
        ? canManageCentralizedOrderSheet()
        : (isAdmin() || isOfficer() || myRole() == 'finance_secretary');
    }

    // Commerce / Merchandise Orders
    // Public order creation and masked status lookup are routed exclusively through
    // backend POST /api/orders and GET /api/orders/track (Admin SDK) to prevent PII
    // scraping and client-side price/payment tampering.
    match /orders/{orderId} {
      allow read: if canManageOrders() || isAdmin();
      allow create: if canManageOrders() || isAdmin();
      allow update: if canManageOrders() || isAdmin();
      allow delete: if isAdmin() || canManageOrders();
    }

    // Products Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if canManageOrders() || isAdmin();
    }

    // Top-Level Fund Accounts (FISCAL_YEAR_BUDGET, FSG_REMITTANCE, IGF, IGP)
    match /fundAccounts/{accountId} {
      allow read: if canViewFinance() || canManageOrders();
      allow create, update: if (canEditFinance() || canManageOrders()) && isSignedIn();
      allow delete: if isAdmin();
    }

    // Budget Allocations (Linked to approved activity/resolutions)
    match /budgetAllocations/{allocationId} {
      allow read: if canViewFinance();
      allow create: if canEditFinance() && isSignedIn();
      allow update: if canEditFinance() && isSignedIn();
      allow delete: if isAdmin() || canEditFinance();
    }

    // Transactions (Append-Only Ledger. Physical deletion and editing of posted rows prohibited)
    match /transactions/{transactionId} {
      allow read: if canViewFinance() || canManageOrders();
      allow create: if (canEditFinance() || canManageOrders()) && isSignedIn();
      // Draft/incomplete/pending rows may be edited; posted rows may ONLY flip status
      // to 'reversed' while keeping immutable financial fields intact.
      allow update: if (canEditFinance() || canManageOrders()) && (
        resource.data.status in ['draft', 'incomplete', 'pending_approval']
        || (
          resource.data.status == 'posted'
          && request.resource.data.status == 'reversed'
          && request.resource.data.amountCentavos == resource.data.amountCentavos
          && request.resource.data.fundAccountId == resource.data.fundAccountId
          && request.resource.data.transactionType == resource.data.transactionType
          && request.resource.data.refNumber == resource.data.refNumber
        )
      );
      // Append-only ledger immutability: posted & reversed entries can never be physically deleted
      allow delete: if (isAdmin() || canEditFinance())
        && resource.data.status in ['draft', 'incomplete'];
    }

    // Pre-Order Batches (IGF merchandise and uniform runs)
    match /preOrderBatches/{batchId} {
      allow read: if canViewFinance() || canManageOrders() || isOfficer() || isAdmin();
      allow create: if canEditFinance() && isSignedIn();
      allow update: if canEditFinance() || canAuditClear();
      allow delete: if isAdmin();
    }

    // Pre-Order Entries (Per-student order ledger)
    match /preOrderEntries/{entryId} {
      allow read: if canViewFinance() || canManageOrders() || isOfficer() || isAdmin();
      allow create, update: if canEditFinance() && isSignedIn();
      allow delete: if isAdmin();
    }

    // Income-Generating Projects (IGP): Lockers & Collections
    match /lockers/{lockerId} {
      allow read: if canViewFinance() || isOfficer() || isAdmin() || myRole() == 'governor';
      allow create, update: if (canEditFinance() || isOfficer() || myRole() == 'governor') && isSignedIn();
      allow delete: if isAdmin();
    }

    match /igpCollections/{collectionId} {
      allow read: if canViewFinance() || isOfficer() || isAdmin() || myRole() == 'governor' || myRole() == 'representative';
      allow create: if (canEditFinance() || isOfficer() || myRole() == 'governor' || myRole() == 'representative') && isSignedIn();
      allow update, delete: if (isAdmin() || canEditFinance()) && isSignedIn();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}