rules_version = '2';

// =============================================================================
// firestore.rules
//
// READ THIS BEFORE DEPLOYING
// -----------------------
// This repository previously had NO rules file. Whatever rules are live in the
// Firebase console for project `ssg-prototype` were set up outside the repo and
// are therefore NOT reflected here.
//
// The roster rules (classRosters / classSections) are strict and are the point
// of this file. The rules for every other collection are deliberately written to
// match how the app already behaves — review them against the console before
// deploying, or you may lock out a feature that currently works.
//
// Deploy with:  firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPERS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userPath());
    }

    // The role stored on the user document. Anonymous callers get null.
    function myRole() {
      return hasUserDoc() ? get(userPath()).data.role : null;
    }

    function isAdmin() {
      return myRole() == 'admin' || myRole() == 'president';
    }

    // SSG Officers: roles allowed to verify rosters and manage institutional records.
    function isOfficer() {
      return myRole() == 'admin'
        || myRole() == 'president'
        || myRole() == 'vice_president'
        || myRole() == 'secretary'
        || myRole() == 'executive_secretary'
        || myRole() == 'press_secretary'
        || myRole() == 'linkages_secretary'
        || myRole() == 'deputy_secretary';
    }

    // True when an Admin has individually granted this account a permission.
    // Mirrors the `permissionOverrides` map written by User Management, so the
    // database agrees with what the UI offers. Without this the roster browser
    // would appear for a granted user and then fail on every query.
    function hasOverride(permission) {
      return hasUserDoc()
        && get(userPath()).data.permissionOverrides[permission] == true;
    }

    // Roles allowed to read student lists. Mayors (who are Guests) and Members
    // may submit a roster but must never read one back — this mirrors
    // `canViewRosters` in src/utils/permissions.js. The Secretary is included
    // because verifying a submission requires reading it.
    function canReadRosters() {
      return myRole() == 'admin'
        || myRole() == 'secretary'
        || myRole() == 'governor'
        || hasOverride('canViewRosters');
    }

    // Roles allowed to accept a remittance and confirm it. Must stay in step with
    // DEATH_AID_MANAGER_ROLES in src/utils/permissions.js. An allowlist, so any
    // role not named here — Members, Guests, Senators, Creatives — is excluded.
    // Note this is wider than isOfficer(), which still governs roster
    // verification and the section registry.
    function canManageDeathAid() {
      return myRole() == 'admin'
        || myRole() == 'president'
        || myRole() == 'vice_president'
        || myRole() == 'secretary'
        || myRole() == 'executive_secretary'
        || myRole() == 'press_secretary'
        || myRole() == 'linkages_secretary'
        || myRole() == 'deputy_secretary'
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer'
        || myRole() == 'governor'
        || myRole() == 'representative'
        || myRole() == 'senator';
    }

    // A Mayor may read exactly one roster: the one they submitted. They cannot
    // browse the roster registry, but Death Aid payment marks have to be made
    // against their own students.
    function isOwnRoster() {
      return isSignedIn() && resource.data.mayorUid == request.auth.uid;
    }

    // A submission is only ever a proposal. `status`, `isCurrent` and `version`
    // are the fields that make a roster official, so nobody outside an officer
    // may set them.
    function isUnverifiedProposal() {
      return request.resource.data.status == 'pending'
        && request.resource.data.isCurrent == false
        && request.resource.data.version == null;
    }

    function hasRosterShape() {
      return request.resource.data.keys().hasAll([
          'college', 'program', 'section', 'sectionKey',
          'students', 'studentCount', 'status', 'submittedAt'
        ])
        && request.resource.data.students is list
        && request.resource.data.studentCount == request.resource.data.students.size();
    }

    // =========================================================================
    // CLASS ROSTERS
    //
    // The financial guarantee: a Mayor may submit a list, but only an officer
    // can turn one into the verified roster that Death Aid reporting bills
    // against. Anonymous visitors can submit too — Mayors have no login.
    // =========================================================================
    match /classRosters/{rosterId} {

      // Student lists are readable by Governors, the Secretary and Admin only,
      // plus the Mayor who submitted the roster (needed to mark payments).
      // Everyone else may still create a roster (see `allow create` below).
      allow read: if canReadRosters() || isOwnRoster();

      // Anyone may submit a proposal, signed in or not — provided it arrives
      // explicitly unverified.
      allow create: if isUnverifiedProposal() && hasRosterShape();

      // Only officers may act on a roster arbitrarily.
      // A roster that is already verified has its student list frozen, so an
      // officer cannot silently rewrite an official historical record; the only
      // way to change a verified list is to verify a NEW submission, which
      // supersedes this one and preserves it as an earlier version.
      //
      // The submitter also has limited rights, because a Mayor who uploaded the
      // wrong file must be able to fix it:
      //   - while it is still pending they may edit or delete it freely;
      //   - a VERIFIED roster may only be amended for student transfers, and
      //     such an amendment is forced back to pending so an officer verifies
      //     it. It is never applied silently to an official record.
      allow update: if (
        isOfficer() && (
          resource.data.status != 'verified'
          || request.resource.data.students == resource.data.students
        )
      ) || (
        isSignedIn()
        && resource.data.mayorUid == request.auth.uid
        && (
          resource.data.status != 'verified'
          || (
            // Transfers must be declared, and re-verified before they count.
            request.resource.data.status == 'pending'
            && request.resource.data.hasTransfers == true
            && request.resource.data.transferCount is int
            && request.resource.data.transferCount > 0
            && request.resource.data.transferReason is string
            && request.resource.data.transferReason.size() > 0
          )
        )
      );

      // Deleting a VERIFIED roster stays officer/admin-only: it is the source of
      // the enrolled count that every Death Aid collection is checked against,
      // so removing it would orphan the financial records built on it. A
      // submitter may withdraw their own submission before it is verified.
      allow delete: if isAdmin() || (
        isSignedIn()
        && resource.data.mayorUid == request.auth.uid
        && resource.data.status != 'verified'
      );
    }

    // =========================================================================
    // CLASS SECTIONS (the registry)
    //
    // Maintained by officers on verification. The `currentRosterId` pointer
    // here is what retires a superseded version, so it is never writable by a
    // submitter.
    // =========================================================================
    match /classSections/{sectionId} {
      allow read: if canReadRosters();
      allow write: if isOfficer();
    }

    // =========================================================================
    // USERS
    // =========================================================================
    match /users/{userId} {
      allow read: if isAdmin() || isOfficer() || (isSignedIn() && request.auth.uid == userId);

      // Self-registration may only ever assign 'member' or 'guest' with no
      // permissionOverrides — otherwise a new user could create their profile
      // with role: 'admin'. Admins and officers may provision any role.
      allow create: if isAdmin() || isOfficer()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.role in ['member', 'guest']
          && (
            !('permissionOverrides' in request.resource.data)
            || (
              request.resource.data.permissionOverrides is map
              && request.resource.data.permissionOverrides.size() == 0
            )
          )
        );

      // Changing the role or the individual access map is an administrative act.
      // A user may edit the rest of their own profile, but never their own
      // authority — otherwise a Member could promote themselves to admin.
      allow update: if isAdmin() || isOfficer()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'permissionOverrides'])
        );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // AUDIT LOGS — append only, never editable or removable
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isOfficer();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // =========================================================================
    // PUBLIC-FACING CONTENT — readable without signing in, writable by officers
    // =========================================================================
    function canManageAnnouncements() {
      return isAdmin()
        || isOfficer()
        || myRole() == 'superadmin'
        || myRole() == 'general_secretary'
        || myRole() == 'creatives'
        || myRole() == 'governor'
        || myRole() == 'adviser'
        || myRole() == 'senator'
        || myRole() == 'representative'
        || hasOverride('canSendNotifications')
        || hasOverride('canManageAnnouncements')
        || hasOverride('canCreateAnnouncements');
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if canManageAnnouncements();
    }

    match /newsArticles/{docId} {
      allow read: if true;
      allow write: if canManageAnnouncements();
    }

    match /calendarEvents/{docId} {
      allow read: if true;
      allow write: if canManageAnnouncements();
    }

    match /terms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // INVENTORY & BORROWING LOGS — public/signed-in readable, officer-managed writes
    // =========================================================================
    match /inventory/{docId} {
      allow read: if true;
      allow write: if canManageOrders() || isAdmin() || hasOverride('canManageInventory');
    }

    // =========================================================================
    // MEMBERS / ORGANIZATIONS
    // =========================================================================
    match /members/{memberId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin() || canManageOrders() || hasOverride('canManageMembers');
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }

    match /borrowingLogs/{logId} {
      allow read: if isSignedIn();
      allow write: if canManageOrders() || isAdmin() || hasOverride('canManageInventory');
    }

    // =========================================================================
    // FINANCE — officers only. Members may still see their own dues, so finance
    // documents are readable by any signed-in user but never written by one.
    // =========================================================================
    match /budgets/{budgetId} {
      allow read: if isSignedIn();
      allow write: if isOfficer() || isAdmin();
    }

    match /funds/{fundId} {
      allow read: if isSignedIn();
      allow write: if myRole() == 'finance_secretary' 
        || myRole() == 'auditor' 
        || myRole() == 'budget_officer' 
        || isOfficer() 
        || isAdmin();
    }

    // =========================================================================
    // DEATH AID
    //
    // Integrity rules that the client cannot be trusted to enforce:
    //   - a collection must belong to a roster this Mayor actually submitted
    //   - expectedCollection must equal paidCount x contributionPerStudent
    //   - the counts must agree with the payment marks
    //   - a Mayor may never confirm their own remittance
    //   - remittance amounts are written once and never overwritten
    // =========================================================================

    // The roster a collection was built from, used to prove ownership.
    function rosterFor(id) {
      return get(/databases/$(database)/documents/classRosters/$(id)).data;
    }

    // A collection whose arithmetic is self-consistent and whose enrolled count
    // matches the verified roster it was recorded against.
    //
    // The roster cross-check is the important one: enrolledCount is what the
    // debt is calculated against, so an officer (or anyone who reaches this
    // rule) cannot shrink it to erase an outstanding balance.
    function hasValidCollectionTotals() {
      let r = request.resource.data;
      let roster = rosterFor(r.rosterId);
      return roster.status == 'verified'
        && r.enrolledCount == roster.studentCount
        && r.beneficiaryCount >= 0
        && r.beneficiaryCount <= r.enrolledCount
        && r.contributionPerStudent >= 0
        && r.collectedAmount == r.beneficiaryCount * r.contributionPerStudent
        && r.expectedCollection == r.enrolledCount * r.contributionPerStudent
        && r.debtCount == r.enrolledCount - r.beneficiaryCount
        && r.debtAmount == r.debtCount * r.contributionPerStudent
        && r.status == 'for_verification'
        && (
          !('beneficiaryCaseId' in r)
          || (
            r.beneficiaryCaseId is string
            && get(/databases/$(database)/documents/deathAidBeneficiaries/$(r.beneficiaryCaseId)).data.status == 'open'
          )
        )
        && (
          (isSignedIn() && r.recordedByUid == request.auth.uid) ||
          (!isSignedIn() && r.recordedByUid == null && r.submittedByName is string && r.submittedByName.size() > 0)
        );
    }

    // Official Death Aid / TechnoCare beneficiary cases (memo + affected person).
    // Public read so students and mayors can see the call for donation and pick
    // the beneficiary; only Death Aid managers may publish or close a case.
    match /deathAidBeneficiaries/{beneficiaryId} {
      allow read: if true;
      allow create, update: if canManageDeathAid()
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.affectedPersonName is string
        && request.resource.data.affectedPersonName.size() > 0
        && request.resource.data.memoPhotoDataUrl is string
        && request.resource.data.memoPhotoDataUrl.size() > 0
        && request.resource.data.aidType in ['death_aid', 'technocare']
        && request.resource.data.status in ['open', 'closed'];
      allow delete: if isAdmin();
    }

    match /deathAidCollections/{collectionId} {
      // Publicly readable so students, members, and guests can track verification status.
      allow read: if true;

      // Recorded by an officer, signed-in member, or guest with required name indicator.
      // Arithmetic totals MUST strictly balance against beneficiaryCount * contributionPerStudent.
      allow create: if hasValidCollectionTotals();

      // Only officers can verify or update death aid collections
      allow update: if canManageDeathAid()
        && request.resource.data.enrolledCount == resource.data.enrolledCount
        && request.resource.data.beneficiaryCount == resource.data.beneficiaryCount
        && request.resource.data.contributionPerStudent == resource.data.contributionPerStudent
        && request.resource.data.collectedAmount == resource.data.collectedAmount
        && request.resource.data.expectedCollection == resource.data.expectedCollection
        && request.resource.data.debtCount == resource.data.debtCount
        && request.resource.data.debtAmount == resource.data.debtAmount
        && request.resource.data.recordedByUid == resource.data.recordedByUid
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.resource.data.debtRecords.size() <= resource.data.debtCount;

      allow delete: if isAdmin();
    }

    match /deathAidRemittances/{remittanceId} {
      allow read: if canManageDeathAid();

      // Written once, by an officer, for a collection still awaiting
      // verification. An officer who RECORDED the collection holds the same
      // cash, so they may not also certify it. (Guest submissions have null recordedByUid).
      allow create: if canManageDeathAid()
        && (
          request.auth.uid != get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.recordedByUid
          || get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.recordedByUid == null
        )
        && get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.status
             == 'for_verification'
        && request.resource.data.collectionId == remittanceId
        && request.resource.data.reportedAmount
             == get(/databases/$(database)/documents/deathAidCollections/$(remittanceId)).data.collectedAmount
        && request.resource.data.difference
             == request.resource.data.amountReceived - request.resource.data.reportedAmount
        && request.resource.data.status == (
               request.resource.data.difference == 0 ? 'confirmed' : 'discrepancy'
             )
        && request.resource.data.receivedByUid == request.auth.uid;

      // Amounts are immutable. An officer may only later mark a discrepancy
      // resolved; the figures that were verified can never change.
      allow update: if canManageDeathAid()
        && request.resource.data.reportedAmount == resource.data.reportedAmount
        && request.resource.data.amountReceived == resource.data.amountReceived
        && request.resource.data.difference == resource.data.difference
        && request.resource.data.receivedByUid == resource.data.receivedByUid
        && request.resource.data.status == 'resolved';

      allow delete: if isAdmin();
    }

    // Append-only audit trail. Officers, members & guests may append their submission actions,
    // but cannot spoof another user's actorUid.
    match /deathAidAuditLog/{entryId} {
      allow read: if canManageDeathAid();
      allow create: if request.resource.data.collectionId is string
        && request.resource.data.action is string
        && (
          canManageDeathAid()
          || (isSignedIn() && request.resource.data.actorUid == request.auth.uid)
          || (!isSignedIn() && request.resource.data.actorUid == null)
        );
      allow update, delete: if false;
    }

    // Collection id allocation counter — strictly monotonic (+1 per transaction).
    match /deathAidCounters/{year} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count', 'year', 'updatedAt'])
        && request.resource.data.count == 1
        && request.resource.data.year is int;
      allow update: if request.resource.data.keys().hasOnly(['count', 'year', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.year == resource.data.year;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // DOCUMENT REPOSITORY (Phase 1)
    //
    // Firestore holds the searchable record; the binary lives in Storage.
    // Roles are checked against the office that manages documents, which is
    // kept deliberately narrow — a member should not be able to read every
    // signed administrative record in the institution.
    // =========================================================================

    // Roles permitted to work with the document archive.
    function canManageDocuments() {
      return isAdmin()
        || isOfficer()
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer'
        || myRole() == 'representative'
        || myRole() == 'senator'
        || hasOverride('canExportData');
    }

    match /documents/{documentId} {
      allow read: if canManageDocuments();
      allow create: if canManageDocuments() && isSignedIn();
      allow update: if canManageDocuments() && isSignedIn();
      allow delete: if isAdmin() || isOfficer()
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer'
        || hasOverride('canDeleteData');

      // Reserved for Phase 4: per-document signature checklists.
      match /signatures/{signatureId} {
        allow read: if canManageDocuments();
        allow write: if isAdmin() || myRole() == 'secretary';
      }

      // Reserved for Phase 1/3: append-only activity history.
      match /auditLogs/{logId} {
        allow read: if canManageDocuments();
        allow create: if canManageDocuments() && isSignedIn();
        allow update, delete: if false;
      }
    }

    // The label taxonomy. Anyone managing documents may define labels, since
    // labels are vocabulary rather than records.
    match /documentLabels/{labelId} {
      allow read: if canManageDocuments();
      allow write: if canManageDocuments() && isSignedIn();
    }

    // Reserved for Phase 6/7: report templates and approval workflows.
    match /documentTemplates/{templateId} {
      allow read: if canManageDocuments();
      allow write: if isAdmin() || myRole() == 'secretary';
    }

    match /officials/{officialId} {
      allow read: if canManageDocuments();
      allow write: if isAdmin() || myRole() == 'secretary';
    }

    match /approvalWorkflows/{workflowId} {
      allow read: if canManageDocuments();
      allow write: if isAdmin() || myRole() == 'secretary';
    }

    // Campus Map Trees & Annotations: public can read, strictly admins can write.
    match /campusMetadata/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // FINANCE & TREASURY GOVERNANCE
    // =========================================================================
    function canViewFinance() {
      return myRole() == 'admin'
        || myRole() == 'president'
        || myRole() == 'vice_president'
        || myRole() == 'secretary'
        || myRole() == 'executive_secretary'
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer'
        || hasOverride('canViewFinance');
    }

    function canEditFinance() {
      return myRole() == 'admin'
        || myRole() == 'president'
        || myRole() == 'vice_president'
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer'
        || hasOverride('canEditFinance');
    }

    function canApproveFinance() {
      return myRole() == 'admin'
        || myRole() == 'president'
        || myRole() == 'vice_president'
        || myRole() == 'finance_secretary'
        || myRole() == 'budget_officer'
        || hasOverride('canApproveFinance');
    }

    function canAuditClear() {
      return myRole() == 'admin'
        || myRole() == 'president'
        || myRole() == 'auditor'
        || hasOverride('canAuditFinance');
    }

    function canManageCentralizedOrderSheet() {
      return myRole() == 'admin'
        || myRole() == 'secretary'
        || myRole() == 'executive_secretary'
        || myRole() == 'deputy_secretary'
        || myRole() == 'press_secretary'
        || myRole() == 'linkages_secretary'
        || myRole() == 'finance_secretary'
        || hasOverride('canManageCentralizedOrderSheet');
    }

    function canManageOrders() {
      return myRole() == 'admin'
        || myRole() == 'president'
        || myRole() == 'vice_president'
        || myRole() == 'secretary'
        || myRole() == 'executive_secretary'
        || myRole() == 'deputy_secretary'
        || myRole() == 'press_secretary'
        || myRole() == 'linkages_secretary'
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer'
        || myRole() == 'governor'
        || myRole() == 'representative'
        || myRole() == 'senator'
        || hasOverride('canManageOrders');
    }

    // System & Centralized Sheet Settings
    match /settings/{settingId} {
      allow read: if settingId == 'app' || isSignedIn();
      allow write: if settingId == 'commerceOrderSheet'
        ? canManageCentralizedOrderSheet()
        : (isAdmin() || isOfficer() || myRole() == 'finance_secretary');
    }

    // Commerce / Merchandise Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if canManageOrders() || isAdmin()
        || !('orderStatus' in request.resource.data)
        || request.resource.data.orderStatus in ['Pending', 'Online Paid'];
      allow update: if canManageOrders() || isAdmin();
      allow delete: if isAdmin() || canManageOrders();
    }

    // Products Catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if canManageOrders() || isAdmin();
    }

    // Top-Level Fund Accounts (FISCAL_YEAR_BUDGET, FSG_REMITTANCE, IGF, IGP)
    match /fundAccounts/{accountId} {
      allow read: if canViewFinance() || canManageOrders();
      allow create, update: if (canEditFinance() || canManageOrders()) && isSignedIn();
      allow delete: if isAdmin();
    }

    // Budget Allocations (Linked to approved activity/resolutions)
    match /budgetAllocations/{allocationId} {
      allow read: if canViewFinance();
      allow create: if canEditFinance() && isSignedIn();
      allow update: if canEditFinance() && isSignedIn();
      allow delete: if isAdmin() || canEditFinance();
    }

    // Transactions (Append-Only Ledger. Physical deletion and editing of posted rows prohibited)
    match /transactions/{transactionId} {
      allow read: if canViewFinance() || canManageOrders();
      allow create: if (canEditFinance() || canManageOrders()) && isSignedIn();
      // Only draft/incomplete can be modified or soft-deleted; posted rows require a linked reversal
      allow update: if (canEditFinance() || canManageOrders()) && (
        resource.data.status == 'draft' ||
        resource.data.status == 'incomplete' ||
        resource.data.status == 'pending_approval' ||
        request.resource.data.status == 'reversed'
      );
      allow delete: if isAdmin() || (
        canEditFinance() && (resource.data.status == 'draft' || resource.data.status == 'incomplete')
      );
    }

    // Pre-Order Batches (IGF merchandise and uniform runs)
    match /preOrderBatches/{batchId} {
      allow read: if isSignedIn();
      allow create: if canEditFinance() && isSignedIn();
      allow update: if canEditFinance() || canAuditClear();
      allow delete: if isAdmin();
    }

    // Pre-Order Entries (Per-student order ledger)
    match /preOrderEntries/{entryId} {
      allow read: if isSignedIn();
      allow create, update: if canEditFinance() && isSignedIn();
      allow delete: if isAdmin();
    }

    // Income-Generating Projects (IGP): Lockers & Collections
    match /lockers/{lockerId} {
      allow read: if isSignedIn();
      allow create, update: if (canEditFinance() || isOfficer()) && isSignedIn();
      allow delete: if isAdmin();
    }

    match /igpCollections/{collectionId} {
      allow read: if isSignedIn();
      allow create: if (canEditFinance() || isOfficer()) && isSignedIn();
      allow update, delete: if (isAdmin() || canEditFinance()) && isSignedIn();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}