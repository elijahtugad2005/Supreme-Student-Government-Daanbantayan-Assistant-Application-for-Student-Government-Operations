        </mxCell>
        
        <!-- Indexes Box -->
        <mxCell id="gridfs-indexes" value="Indexes: &#xa;• files_id + n (for chunk retrieval)&#xa;• filename (for searching)&#xa;• metadata.documentId (for linking)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;spacingLeft=10;spacingTop=5;fontStyle=1" vertex="1" parent="mongodb-box">
