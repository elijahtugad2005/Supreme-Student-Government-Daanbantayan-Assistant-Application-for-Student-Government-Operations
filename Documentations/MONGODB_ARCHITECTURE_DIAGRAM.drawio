          <mxGeometry x="20" y="60" width="560" height="280" as="geometry" />
        </mxCell>
        
        <mxCell id="gridfs-files-struct" value="{&#xa;  _id: ObjectId('507f1f77bcf86cd799439011'),&#xa;  length: 2457891,  // file size in bytes&#xa;  chunkSize: 261120,  // 255KB default&#xa;  uploadDate: ISODate('2027-02-08T15:30:00Z'),&#xa;  filename: 'Resolution-2026-014.pdf',&#xa;  &#xa;  metadata: {&#xa;    // Custom metadata&#xa;    originalName: 'Resolution 2026-014.pdf',&#xa;    mimeType: 'application/pdf',&#xa;    uploadedBy: 'firebase-uid-123',&#xa;    uploadedByName: 'John Doe',&#xa;    documentId: 'firestore-doc-id',  // Link back to Firestore&#xa;    documentType: 'resolution',&#xa;    office: 'Secretariat'&#xa;  }&#xa;}" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontFamily=Courier New;spacingLeft=10;spacingTop=5" vertex="1" parent="gridfs-files-box">
          <mxGeometry x="10" y="40" width="540" height="230" as="geometry" />
        </mxCell>
        
        <!-- GridFS Chunks Collection -->
        <mxCell id="gridfs-chunks-box" value="Collection: documents.chunks (GridFS Binary Data)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="mongodb-box">
          <mxGeometry x="20" y="360" width="560" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="gridfs-chunks-struct" value="{&#xa;  _id: ObjectId('...'),&#xa;  files_id: ObjectId('507f1f77bcf86cd799439011'),  // references files._id&#xa;  n: 0,  // chunk number (0-indexed)&#xa;  data: Binary('...base64...')  // 255KB of binary data&#xa;}&#xa;&#xa;// Multiple chunks for large files:&#xa;// { _id: ..., files_id: ..., n: 0, data: ... }&#xa;// { _id: ..., files_id: ..., n: 1, data: ... }&#xa;// { _id: ..., files_id: ..., n: 2, data: ... }" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontFamily=Courier New;spacingLeft=10;spacingTop=5" vertex="1" parent="gridfs-chunks-box">
