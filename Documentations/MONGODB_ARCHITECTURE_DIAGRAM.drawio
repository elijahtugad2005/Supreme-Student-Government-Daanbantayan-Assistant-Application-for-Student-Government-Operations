        </mxCell>
        
        <mxCell id="fs-existing" value="// EXISTING FIELDS (UNCHANGED)&#xa;{&#xa;  id: 'auto-generated-id',&#xa;  title: 'Resolution No. 2026-014',&#xa;  documentNumber: '2026-014',&#xa;  status: 'pending' | 'under_review' | 'approved',&#xa;  documentDate: '2026-02-08',&#xa;  office: 'Secretariat',&#xa;  labels: ['resolution', 'legislative'],&#xa;  keywords: ['budget', 'approval'],&#xa;  &#xa;  originalFileName: 'Resolution-2026-014.pdf',&#xa;  mimeType: 'application/pdf',&#xa;  fileSize: 2457891,  // bytes&#xa;  &#xa;  createdBy: 'firebase-uid-123',&#xa;  createdByName: 'John Doe',&#xa;  createdAt: Timestamp,&#xa;  updatedAt: Timestamp,&#xa;  updatedBy: 'firebase-uid-123',&#xa;  &#xa;  // AI Processing fields&#xa;  aiState: 'not_processed' | 'processing' | 'suggested' | 'verified',&#xa;  extractedText: '...',&#xa;  summary: '...',&#xa;  aiConfidence: 0.95,&#xa;  aiProcessedAt: Timestamp,&#xa;  aiSuggestion: {...},&#xa;  aiExtraction: {...}&#xa;}" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontFamily=Courier New;spacingLeft=10;spacingTop=10" vertex="1" parent="firestore-box">
          <mxGeometry x="20" y="90" width="560" height="390" as="geometry" />
        </mxCell>
        
        <mxCell id="fs-new" value="// NEW FIELDS (MONGODB INTEGRATION)&#xa;{&#xa;  // Storage reference (NEW)&#xa;  mongoFileId: '507f1f77bcf86cd799439011',  // MongoDB ObjectId&#xa;  storageType: 'mongodb' | 'firebase' | 'local',&#xa;  &#xa;  // DEPRECATED (kept for backward compatibility)&#xa;  storagePath: null  // Previously: 'documents/abc123/file.pdf'&#xa;}" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontFamily=Courier New;spacingLeft=10;spacingTop=10;fontStyle=1" vertex="1" parent="firestore-box">
          <mxGeometry x="20" y="500" width="560" height="160" as="geometry" />
        </mxCell>
        
        <!-- MongoDB Collections -->
