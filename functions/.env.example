# Cloud Function secrets and configuration.
#
# This file lives in the FUNCTION, not in the web app. The React bundle must
# never contain the key: Vite only inlines VITE_-prefixed variables, so an
# unprefixed name here cannot leak into the browser.
#
# Setup
#   copy functions\.env.example functions\.env      (Windows)
#   cp functions/.env.example functions/.env        (macOS / Linux)
#   then replace the placeholder below with your real key.
#
# Deploying for real? Prefer a managed secret over a committed file:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set OPENROUTER_API_KEY
#   firebase deploy --only functions
#
# Free tier limits to plan for: ~15 requests/minute and ~1,500 requests/day.
# Each analysed document costs up to three requests (classify, extract,
# summarize), so the client paces the queue accordingly.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Defaults to the value in functions/src/index.js when unset.
# Note: gemini-2.5-flash is no longer available to new Gemini projects and
# returns HTTP 404, so do not downgrade to it.
GEMINI_MODEL=gemini-3.8-flash

# ────────────────────────────────────────────────────────────
# BACKUP PROVIDER
#
# Gemini's daily allowance does not reset until midnight Pacific. When it is
# spent, requests fall through to OpenRouter automatically, so the assistant
# keeps working. Setting only this key uses OpenRouter from the start.
# ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional. The ":free" suffix selects OpenRouter's free tier.
OPENROUTER_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional. Lets OpenRouter attribute usage to your site.
OPENROUTER_SITE_URL=http://localhost:5173