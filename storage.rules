rules_version = '2';

// =============================================================================
// storage.rules
//
// The document repository splits storage across two places:
//   Firestore -> the searchable record (documents/{id})
//   Storage   -> the original binary, at documents/{id}/{filename}
//
// The two must agree. A rule here cannot check the Firestore record, so it
// repeats the role check via the synced `role` JWT custom claim.
// `canManageDocuments` and `canDeleteDocuments` mirror firestore.rules.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return isSignedIn()
        && request.auth.token.role != null
        ? request.auth.token.role
        : null;
    }

    function isAdmin() {
      return myRole() == 'admin' || myRole() == 'president';
    }

    function isOfficer() {
      return isAdmin()
        || myRole() == 'vice_president'
        || myRole() == 'secretary'
        || myRole() == 'executive_secretary'
        || myRole() == 'press_secretary'
        || myRole() == 'linkages_secretary'
        || myRole() == 'deputy_secretary';
    }

    // NOTE: role comes from a custom claim, not the Firestore user document.
    // Storage rules cannot make a Firestore read. Mirrors firestore.rules
    // `canManageDocuments()` for role-based access.
    function canManageDocuments() {
      return isAdmin()
        || isOfficer()
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer'
        || myRole() == 'representative'
        || myRole() == 'senator';
    }

    // Mirrors firestore.rules documents/{documentId} allow delete:
    // Representatives and Senators can read/upload documents, but only
    // Admins, Secretariat Officers, and Finance Officers may delete binaries.
    function canDeleteDocuments() {
      return isAdmin()
        || isOfficer()
        || myRole() == 'finance_secretary'
        || myRole() == 'auditor'
        || myRole() == 'budget_officer';
    }

    // Strict upload guard:
    //  - Non-empty and strictly under 25 MB
    //  - Exact anchored MIME allowlist (blocks executables, HTML, SVG XSS,
    //    and spoofed `.*word.*` content types)
    function isValidDocumentUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          '^(application/pdf|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|text/plain|image/(jpeg|jpg|png|webp|gif))$'
        );
    }

    match /documents/{documentId}/{fileName} {
      // Reading a document requires the same role as reading its metadata.
      allow read: if canManageDocuments();

      // Uploads and replacements ALWAYS enforce size and MIME-type restrictions.
      // Never add an unconditional `allow write:` here (Firebase Rules ORs
      // sibling allow statements, which would silently bypass these checks).
      allow create, update: if canManageDocuments()
        && isValidDocumentUpload();

      // Deletes carry request.resource == null, so they are authorized
      // separately with delete-tier RBAC matching firestore.rules.
      allow delete: if canDeleteDocuments();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
